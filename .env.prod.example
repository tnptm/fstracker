# Copy to .env.prod (gitignored) and fill in. Used with:
#   docker compose --env-file .env.prod -f compose.prod.yaml up -d --build

DOMAIN=fs.tnptm.top

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=fstracker
POSTGRES_USER=fstracker

DJANGO_TIME_ZONE=Europe/Helsinki

# Sign-up rate limits (per IP / whole site)
DJANGO_THROTTLE_REGISTER=5/hour
DJANGO_THROTTLE_REGISTER_GLOBAL=100/hour

# GDPR: delete accounts unused for this many months (0 = never). Needs the daily
# `enforce_retention` cron job, see docs/DATA_HANDLING.md. Update the privacy page if you change it.
DJANGO_INACTIVE_ACCOUNT_MONTHS=24

# Gunicorn: keep GUNICORN_WORKERS=1, users' encryption keys live in that process' memory
# (see backend/gunicorn.conf.py). Scale with threads instead.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# Host ports (bound to 127.0.0.1 only, nginx proxies to them)
FRONTEND_PORT=3000
BACKEND_PORT=8000
